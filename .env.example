# Copy this file to ".env" (same folder) and fill in ONE of the options below.
# ".env" is listed in .gitignore, so it is never committed.
# Never prefix these with VITE_ — that would expose them to the browser.
# Leave everything empty to run in demo mode: checked guidance, no AI calls.

# ---------- Option A: Google Gemini (free tier available) ----------
# Get a key at https://aistudio.google.com/apikey
# Check https://ai.google.dev/gemini-api/docs/models for current model names.
# Note: on the free tier Google may use submitted text to improve its products.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# ---------- Option B: another OpenAI-compatible provider ----------
# e.g. Featherless.ai (https://api.featherless.ai/v1) or Backboard.io.
# Use the base URL, key and model name from that provider's docs.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# ---------- Option C: Anthropic (Claude) ----------
# Key from https://console.anthropic.com (starts with "sk-ant-").
# Model defaults to claude-opus-5-5; claude-haiku-4-5-20251001 is much cheaper.
# ANTHROPIC_API_KEY=
# AI_MODEL=

# ---------- Optional ----------
# Set to "demo" to force demo mode even when a key is present.
AI_MODE=

# Saves AI requests (on by default): skips the AI when the app's own checked rules
# are already confident, and reuses identical earlier answers. Set to "off" to
# always ask the AI. Tip: on Gemini's free tier, AI_MODEL=gemini-2.5-flash-lite
# usually allows more requests per day than gemini-2.5-flash.
AI_SAVER=
